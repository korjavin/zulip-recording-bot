# zulip-recording-bot configuration. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real hosts, emails or keys. Under Portainer
# set the same variables in the stack environment instead.

# --- Compose / Traefik (read by docker-compose.yml, not by the bot) ----------
# Public host Traefik routes to the bot; only POST /notify and GET /health are
# exposed there.
DOMAIN=recording-bot.example.com
TRAEFIK_NETWORK_NAME=traefik
TRAEFIK_CERTRESOLVER=myresolver

# --- Zulip (required) -------------------------------------------------------
# Base URL of the Zulip server, no trailing slash.
ZULIP_SITE=https://zulip.example.com
# Generic bot: Settings -> Personal -> Bots -> Add a new bot (type "Generic").
ZULIP_BOT_EMAIL=notetaker-bot@zulip.example.com
ZULIP_BOT_API_KEY=your_zulip_api_key_here

# --- HTTP -------------------------------------------------------------------
# Fixed at :8080 by the image (Traefik and PUBLIC_URL use that port), so it is
# not passed through.
#LISTEN_ADDR=:8080
# Base of the callback URLs handed out: recorders post to PUBLIC_URL/events and
# tr2outline to PUBLIC_URL/notify. Use the container name on the shared
# network: /events is not exposed through Traefik.
PUBLIC_URL=http://zulip-recording-bot:8080
# Job state directory. Fixed at /data by the image and docker-compose.yml (the
# only path owned by the container user), so it is not passed through.
#DATA_DIR=/data
# DEBUG, INFO, WARN or ERROR.
LOG_LEVEL=INFO

# --- Recorders --------------------------------------------------------------
# Shared HMAC key for x-recorder-signature, both directions; must equal the
# recorders' RECORDER_SECRET. Required. Generate with: openssl rand -hex 32
RECORDER_SECRET=change-me
# Links under this URL are Jitsi calls (no trailing slash).
JITSI_BASE_URL=https://meet.jit.si
# Recorders on the shared network (container name and port).
JITSI_RECORDER_URL=http://jitsi-recorder:8080
MEET_RECORDER_URL=http://meet-recorder:8080
# Name the recorder joins the call with.
BOT_DISPLAY_NAME=NoteTaker
# Give up if not admitted within this many seconds (Jitsi / Meet lobby).
JOIN_TIMEOUT_S=600
MEET_JOIN_TIMEOUT_S=1200
# Hard cap on one recording (4 hours).
MAX_DURATION_S=14400
# Stop after the room has been empty this long.
EMPTY_GRACE_S=60
# A shorter recording gets a "too short" note and is not transcribed.
MIN_RECORDING_S=15

# --- Transcriber ------------------------------------------------------------
# Where recording.finished is delivered. Empty disables the hand-off.
WEBHOOK_URL=http://transcriber:8000/webhook
# Signs the hand-off and verifies POST /notify; must equal the transcriber's
# and tr2outline's WEBHOOK_SECRET. Required whenever WEBHOOK_URL is set.
WEBHOOK_SECRET=change-me
